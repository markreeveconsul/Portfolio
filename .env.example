# Set this to a Formspree endpoint if you want the contact form to deliver email.
FORMSPREE_ENDPOINT=

# Canonical public URL used for sitemap and social metadata.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional local URL for the separate FastAPI portfolio assistant service.
NEXT_PUBLIC_ASSISTANT_API_URL=http://127.0.0.1:8000

# Optional GitHub token (a fine-grained token with no extra permissions is enough).
# Only raises the API rate limit for the GitHub activity section; never exposed to the browser.
GITHUB_TOKEN=
