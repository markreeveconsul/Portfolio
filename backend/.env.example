# Copy this file to backend/.env. Keep real credentials out of source control.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional delayed backup: starts if Gemini has not answered within this many seconds.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_FALLBACK_DELAY_SECONDS=2
PORTFOLIO_ORIGINS=http://localhost:3000,http://localhost:3005

# Lead email delivery stays disabled until these are configured.
LEADS_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
